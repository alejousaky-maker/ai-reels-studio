 "verifiedClaims": [
  {
   "text": "A dancing epidemic took place in Strasbourg from July to September 1518.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Dancing_plague_of_1518"
  },
  {
   "text": "It began with one woman (named Frau Troffea in most chronicles) dancing without music.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Dancing_plague_of_1518"
  },
  {
   "text": "Dozens joined within weeks (estimates range from about 50 to 400).",
   "status": "uncertain",
   "source": "https://en.wikipedia.org/wiki/Dancing_plague_of_1518"
  },
  {
   "text": "Physicians/council prescribed dancing it out: halls, musicians and strong men were reportedly provided.",
   "status": "uncertain",
   "source": "https://en.wikipedia.org/wiki/Dancing_plague_of_1518"
  },
  {
   "text": "The council later banned public dancing; dancers were sent to a shrine of St Vitus.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Dancing_plague_of_1518"
  },
  {
   "text": "The cause is still debated; stress-induced mass psychogenic illness (John Waller) is the most popular theory.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Dancing_plague_of_1518"
  },
  {
   "text": "Number of deaths is unknown; contemporary sources cited do not mention deaths.",
   "status": "uncertain",
   "source": "https://en.wikipedia.org/wiki/Dancing_plague_of_1518"
  },
  {
   "text": "The yawn comparison is an analogy for social contagion, not a historical claim.",
   "status": "fiction",
   "source": null
  }
 ],
