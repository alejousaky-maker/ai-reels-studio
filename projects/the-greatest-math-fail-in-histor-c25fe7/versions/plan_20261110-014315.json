 "verifiedClaims": [
  {
   "text": "Educated Europeans in 1492 knew the Earth was round; the flat-Earth belief is a later myth.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Myth_of_the_flat_Earth"
  },
  {
   "text": "Earth's circumference was known to be roughly 25,000 miles (Eratosthenes-type estimates).",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Christopher_Columbus"
  },
  {
   "text": "Columbus took Alfraganus's degree in Arabic miles as Roman miles, underestimating Earth by about 25%.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Christopher_Columbus"
  },
  {
   "text": "He placed Japan roughly 2,400 nautical miles west of the Canary Islands.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Christopher_Columbus"
  },
  {
   "text": "Royal experts rejected his plan because his distance estimates were too small.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Christopher_Columbus"
  },
  {
   "text": "He landed in the Bahamas in October 1492 and called the inhabitants 'indios'.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Christopher_Columbus"
  },
  {
   "text": "In 1494 he had his crew swear that Cuba was part of the Asian mainland.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Christopher_Columbus"
  }
 ],
