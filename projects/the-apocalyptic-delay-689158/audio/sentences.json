  },
  {
   "text": "The sun burns.",
   "start": 16.747645833333333,
   "end": 17.767458333333334
  },
  {
   "text": "They touch grass, and nobody knows what it is.",
   "start": 17.907458333333334,
   "end": 20.285104166666667
  },
  {
   "text": "Hour six.",
   "start": 20.425104166666667,
   "end": 21.184395833333333
  },
  {
   "text": "Wall Street notices nobody is buying anything.",
   "start": 21.324395833333334,
   "end": 24.05325
  },
  {
