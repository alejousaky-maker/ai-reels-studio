   "start": 25.952666666666666,
   "end": 27.346875
  },
  {
   "text": "Then a giant red arrow smashes straight through the floor.",
   "start": 27.486875,
   "end": 30.265458333333335
  },
  {
   "text": "Hour twelve.",
   "start": 30.405458333333332,
   "end": 31.188020833333333
  },
  {
   "text": "Traffic stops.",
   "start": 31.328020833333333,
   "end": 32.329166666666666
  },
  {
   "text": "Cars are abandoned in the middle of the road.",
   "start": 32.469166666666666,
   "end": 34.628395833333336
  },
  {
   "text": "Everyone marches to the game studio with cardboard signs.",
   "start": 34.76839583333334,
   "end": 37.9764375
  },
  {
   "text": "Take my kidney, just drop it!",
   "start": 38.1164375,
   "end": 39.910979166666664
  },
  {
   "text": "Hour twenty-four.",
