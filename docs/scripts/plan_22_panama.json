 "verifiedClaims": [
  {
   "text": "The Panama Canal expansion (opened 2016) cost about $5.25 billion; Neopanamax ships pass with only a few metres to spare.",
   "status": "verified"
  },
  {
   "text": "The canal opened in 1914; over 25,000 workers died across the French and American construction eras, mostly of disease.",
   "status": "verified"
  },
  {
   "text": "New locks use gravity-fed water (with water-saving basins), not pumps; tugboats guide ships in the new locks.",
   "status": "verified"
  },
  {
   "text": "About 40 percent of US container traffic passes through the canal; New York to San Francisco is ~8,000 miles shorter.",
   "status": "verified"
  },
  {
   "text": "Droughts in 2023 forced draft limits; some ships paid millions in auctions to jump the queue.",
   "status": "verified"
  }
 ],
