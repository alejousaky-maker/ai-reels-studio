 "verifiedClaims": [
  {
   "text": "Odysseus and his men were trapped in the cave of the Cyclops Polyphemus, sealed by a boulder only the giant could move.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Polyphemus"
  },
  {
   "text": "Polyphemus ate several of the men; Odysseus gave him strong unmixed wine and said his name was 'Nobody' (Outis).",
   "status": "verified",
   "source": "Homer, Odyssey IX"
  },
  {
   "text": "They blinded his single eye with a heated olive-wood stake; the neighbours left when he cried that 'Nobody' was hurting him.",
   "status": "verified",
   "source": "Homer, Odyssey IX"
  },
  {
   "text": "In the morning he moved the stone to let his flock out and the men escaped clinging under the rams.",
   "status": "verified",
   "source": "Homer, Odyssey IX"
  },
  {
   "text": "'Dad joke' is comic framing.",
   "status": "fiction"
  }
