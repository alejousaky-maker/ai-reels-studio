  "beats": [
    {"narration": "When this guy found out his wife was cheating with his boss, he didn't fight. He asked for a promotion.", "environment": "office",
     "spot": 0, "shot": "two_shot", "light": "day", "mood": "upbeat", "impactWord": "promotion",
