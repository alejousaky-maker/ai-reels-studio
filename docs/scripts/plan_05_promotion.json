     "characters": [{"id": "emp", "expr": "neutral", "react": {"word": "president", "expr": "shock"}}],
     "fx": [{"kind": "product", "product": "heart", "word": "messages", "on": "emp"}]},
    {"narration": "Most people would explode. He smiled.", "environment": "apartment", "spot": 1, "shot": "close", "light": "golden", "mood": "curious",
     "characters": [{"id": "emp", "expr": "shock", "react": {"word": "smiled", "expr": "smile"}}]},
    {"narration": "Because his boss had a bigger problem: a billionaire father-in-law.", "environment": "office", "spot": 0, "shot": "medium",
     "light": "day", "mood": "whimsical", "transition": "xfade",
     "characters": [{"id": "boss", "expr": "nervous"}],
     "fx": [{"kind": "product", "product": "exclaim", "word": "billionaire", "on": "boss"}], "text": "BILLIONAIRE FATHER-IN-LAW", "textStyle": "label"},
    {"narration": "So he walked into the corner office.", "environment": "office", "spot": 3, "shot": "wide", "light": "day", "mood": "upbeat",
     "characters": [{"id": "emp", "action": "walk", "expr": "smile"}, {"id": "boss", "expr": "nervous"}], "focus": "emp"},
    {"narration": "He asked for the overseas branch, a huge bonus, and a contract with guaranteed severance.", "environment": "office", "spot": 1,
     "shot": "two_shot", "light": "day", "mood": "curious",
     "characters": [{"id": "emp", "expr": "smile_closed"}, {"id": "boss", "expr": "nervous"}],
     "focus": "emp", "fx": [{"kind": "product", "product": "scroll", "word": "contract", "on": "emp"}]},
    {"narration": "Then he casually mentioned that his doorbell camera backs up to the cloud.", "environment": "office", "spot": 2, "shot": "close",
     "light": "day", "mood": "tense", "impactWord": "doorbell",
     "characters": [{"id": "boss", "expr": "nervous", "react": {"word": "doorbell", "expr": "shock"}}],
     "fx": [{"kind": "product", "product": "camera", "word": "doorbell", "on": "boss"}]},
    {"narration": "The boss signed in record time.", "environment": "office", "spot": 0, "shot": "medium", "light": "day", "mood": "upbeat",
     "characters": [{"id": "boss", "expr": "pained", "holding": "scroll"}],
     "fx": [{"kind": "product", "product": "key", "word": "signed", "on": "boss"}]},
    {"narration": "The contract cleared on a Friday.", "environment": "office", "spot": 1, "shot": "close", "light": "golden", "mood": "warm",
     "characters": [{"id": "emp", "expr": "smile"}],
     "fx": [{"kind": "product", "product": "clock", "word": "Friday", "on": "emp"}]},
    {"narration": "That afternoon, his wife got divorce papers.", "environment": "apartment", "spot": 0, "shot": "medium", "light": "golden",
     "mood": "tense", "transition": "xfade", "impactWord": "divorce",
     "characters": [{"id": "wife", "expr": "smile", "holding": "scroll", "react": {"word": "divorce", "expr": "shock"}}]},
    {"narration": "And the company board got an email. Messages and doorbell clips attached.", "environment": "office", "spot": 2, "shot": "two_shot",
     "light": "day", "mood": "tense", "transition": "xfade",
     "characters": [{"id": "board", "expr": "neutral", "holding": "phone", "react": {"word": "email", "expr": "shock"}}, {"id": "board2", "expr": "stern"}],
     "focus": "board", "fx": [{"kind": "product", "product": "exclaim", "word": "email", "on": "board2"}]},
    {"narration": "By Monday, the vice president was carrying a cardboard box.", "environment": "office", "spot": 3, "shot": "wide", "light": "day",
