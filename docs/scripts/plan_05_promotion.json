     "mood": "curious", "transition": "xfade",
     "characters": [{"id": "emp", "expr": "neutral", "holding": "tablet"}]},
    {"narration": "Including his wife's messages to his vice president.", "environment": "apartment", "spot": 1, "shot": "close", "light": "golden",
