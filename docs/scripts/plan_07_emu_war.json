 "verifiedClaims": [
  {
   "text": "In Nov-Dec 1932 the Australian army (Maj. G.P.W. Meredith, two soldiers, two Lewis guns, 10,000 rounds) was sent against emus in Western Australia.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Emu_War"
  },
  {
   "text": "About 20,000 emus were damaging wheat crops.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Emu_War"
  },
  {
   "text": "At a dam ambush a gun jammed after about a dozen birds were killed; Meredith compared the emus' resilience to tanks.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Emu_War"
  },
  {
   "text": "The operation was withdrawn, resumed, and averaged about 10 rounds per confirmed kill.",
   "status": "verified",
   "source": "https://en.wikipedia.org/wiki/Emu_War"
  },
  {
   "text": "'Lost a war to birds' is the popular comic framing.",
   "status": "fiction"
  }
