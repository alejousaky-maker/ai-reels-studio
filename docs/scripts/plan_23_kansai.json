 "verifiedClaims": [
  {
   "text": "Kansai International Airport (opened 1994) sits on an artificial island about 5 km off the coast in Osaka Bay.",
   "status": "verified"
  },
  {
   "text": "Fill came from cut-down mountains; the seabed holds ~18-20 m of soft alluvial clay.",
   "status": "verified"
  },
  {
   "text": "The island has sunk about 11-12 m since construction, faster than predicted; terminal columns are adjustable with jacks.",
   "status": "verified"
  },
  {
   "text": "Seawalls protect the island (Typhoon Jebi flooded it in 2018); Kansai is repeatedly ranked among the most punctual airports.",
   "status": "verified"
  }
 ]
