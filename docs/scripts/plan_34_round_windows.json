 "verifiedClaims": [
  {
   "text": "The de Havilland Comet (1952) was the first jet airliner; two broke up in flight in Jan and Apr 1954 (BOAC 781, SA 201).",
   "status": "verified"
  },
  {
   "text": "RAE Farnborough tested a Comet fuselage in a water tank, cycling cabin pressure; it failed after ~3,000 cycles from a corner of a cut-out.",
   "status": "verified"
  },
  {
   "text": "Later airliners use rounded windows to avoid stress concentrations at corners.",
   "status": "verified"
  },
  {
   "text": "The Comet's windows were rectangular with tight corners ('square' is a simplification)."
  },
  {
   "text": "The engineer and the boss are generic stickmen; the quoted line is invented.",
   "status": "fiction"
  }
 ],
