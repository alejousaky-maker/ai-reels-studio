 "verifiedClaims": [
  {
   "text": "Ralph Baer, an engineer at defense contractor Sanders Associates, conceived a TV game device in 1966.",
   "status": "verified"
  },
  {
   "text": "The 'Brown Box' prototype (1967-69) was wrapped in wood-grain adhesive; licensed to Magnavox as the Odyssey (1972).",
   "status": "verified"
  },
  {
   "text": "Odyssey games used translucent plastic overlays stuck to the TV screen (they clung by static).",
   "status": "verified"
  },
  {
   "text": "US TV households in 1966: ~50+ million ('tens of millions' is safe); three national networks dominated.",
   "status": "verified"
  },
  {
   "text": "Global games market ~ $180-190 billion per year (2024 estimates).",
   "status": "verified"
  },
  {
   "text": "Some Sanders managers were sceptical but funded it modestly; 'hiding it from the boss' is comedy."
  }
 ]
