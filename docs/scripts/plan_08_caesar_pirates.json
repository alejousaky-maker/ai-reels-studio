 "verifiedClaims": [
  {
   "text": "Around 75 BC Cilician pirates captured young Caesar and asked 20 talents; he said he was worth at least 50.",
   "status": "verified",
   "source": "Plutarch, Life of Caesar 1-2; https://en.wikipedia.org/wiki/Julius_Caesar"
  },
  {
   "text": "He was held about 38 days, wrote poems and speeches, read them to the pirates, called them illiterate barbarians, and told them to be quiet when he slept.",
   "status": "verified",
   "source": "Plutarch, Life of Caesar 1-2; https://en.wikipedia.org/wiki/Julius_Caesar"
  },
  {
   "text": "He jokingly threatened to punish them; after the ransom he raised a fleet without public office, captured them and had them executed.",
   "status": "verified",
   "source": "Plutarch, Life of Caesar 1-2; https://en.wikipedia.org/wiki/Julius_Caesar"
  }
