 "verifiedClaims": [
  {
   "text": "LASIK takes roughly 10-15 minutes for both eyes; patients are awake with numbing drops.",
   "status": "verified"
  },
  {
   "text": "A hinged corneal flap is cut with a femtosecond laser or microkeratome, then an excimer (193 nm UV) laser reshapes the stroma.",
   "status": "verified"
  },
  {
   "text": "Refractive errors come from corneal curvature / eye length; astigmatism = cornea curved more one way (football vs basketball).",
   "status": "verified"
  },
  {
   "text": "No stitches: the flap adheres by the cornea's natural pump/suction within minutes.",
   "status": "verified"
  },
  {
   "text": "Vision often improves within hours; full stabilisation takes days to weeks; not everyone is a candidate."
  },
  {
   "text": "'Like a car hood' is an analogy; the flap is ~0.1 mm thin.",
   "status": "fiction"
  }
 ]
