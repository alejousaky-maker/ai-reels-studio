# AI Reels Studio - optional environment overrides (copy to .env only if you need them; never commit secrets)
# REMOTION_TMP=D:/airs-tmp            # put render temp files on a bigger drive
# AIRS_MODELS=D:/airs-models          # where Kokoro / whisper models live
# AIRS_PROJECTS=D:/airs-projects      # where projects are stored
# AIRS_WHISPER_DEVICE=cuda            # only if CUDA cuBLAS/cuDNN DLLs are installed (default: CPU int8)
# AIRS_GL=angle                       # Chromium GL backend for renders (angle | swangle for no-GPU machines)
# CHROME=C:/path/to/chrome.exe        # use your own Chrome instead of Remotion's headless shell
# ELEVENLABS_API_KEY=                 # NOT used by default; paid service, opt-in only (not implemented in v0.1)
